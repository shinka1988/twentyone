---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Twenty one" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={`${title} | Twenty one。札幌市豊平区平岸のシェアサロン。`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Twenty one | アイブロウ・ネイルサロン" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/images/logo-cropped.jpg" />
    <link rel="apple-touch-icon" href="/images/logo-cropped.jpg" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
