---
import { salonName, salonAddress } from "../data/salon";
import SalonMap from "./SalonMap.astro";
---

<section id="access" class="section">
  <div class="container">
    <h2>ACCESS</h2>
    <p class="subtitle">店舗情報・アクセス</p>

    <div class="info-table">
      <dl>
        <dt>店名</dt><dd>{salonName}</dd>
        <dt>住所</dt><dd>{salonAddress}</dd>
        <dt>営業時間</dt><dd>10:00 - 20:00</dd>
        <dt>定休日</dt><dd>不定休</dd>
        <dt>最寄り駅</dt><dd>札幌市営地下鉄南北線「南平岸駅」西出口から徒歩約2分</dd>
      </dl>
    </div>
  </div>

  <SalonMap />
</section>
