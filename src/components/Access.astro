---
import { salonName, instagramUrl, lineUrl } from "../data/salon";
---

<section id="access" class="section">
  <div class="container">
    <h2>ACCESS</h2>
    <p class="subtitle">店舗情報・アクセス</p>

    <div class="info-table">
      <dl>
        <dt>店名</dt><dd>{salonName}</dd>
        <dt>住所</dt><dd>札幌市豊平区平岸（詳細はお気軽にお問い合わせください）</dd>
        <dt>営業時間</dt><dd>10:00 - 20:00（最終受付 18:30）</dd>
        <dt>定休日</dt><dd>不定休</dd>
        <dt>最寄り駅</dt><dd>南北線 南平岸駅 徒歩数分</dd>
        <dt>お問い合わせ</dt>
        <dd class="contact-links">
          <a href={lineUrl} target="_blank" rel="noopener noreferrer" class="sns-text-link line-text">公式LINEでお問い合わせ</a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="sns-text-link insta-text">Instagramでお問い合わせ</a>
        </dd>
      </dl>
    </div>
  </div>
</section>
