---
import { heroImage, heroMobileImage } from "../data/salon";
---

<section
  id="top"
  class="hero hero-image"
  style={heroImage ? `--hero-image: url(${heroImage}); --hero-mobile-image: url(${heroMobileImage})` : undefined}
  aria-label="twenty one"
>
  <div class="hero-copy" aria-hidden="true">
    <div class="hero-copy-title"><img src="/images/hero/twenty-one-script-pc.png" alt="twenty one" /></div>
    <div class="hero-copy-subtitle">BEAUTY &amp; SHARE SALON</div>
    <div class="hero-copy-line" aria-hidden="true"></div>
    <div class="hero-copy-tagline">美しさをつなぎ、<br />もっと自由に。</div>
    <div class="hero-copy-scroll"><span></span><small>SCROLL</small></div>
  </div>
  <span class="sr-only">twenty one</span>
</section>
